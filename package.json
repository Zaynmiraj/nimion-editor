{
  "name": "nimion-editor",
  "version": "0.1.0",
  "description": "A from-scratch, dependency-free React rich text editor for web apps — custom WYSIWYG built on contentEditable",
  "keywords": [
    "rich-text",
    "wysiwyg",
    "editor",
    "react",
    "react-component",
    "html-editor",
    "contenteditable"
  ],
  "license": "MIT",
  "author": "Zaynmiraj",
  "homepage": "https://github.com/Zaynmiraj/nimion-editor#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Zaynmiraj/nimion-editor.git"
  },
  "bugs": {
    "url": "https://github.com/Zaynmiraj/nimion-editor/issues"
  },
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "clean": "rm -rf dist",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "npm run clean && npm run build"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "jsdom": "^29.1.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.6.0",
    "vitest": "^4.1.6"
  }
}
